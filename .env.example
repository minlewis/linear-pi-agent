LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
INSTALL_SECRET=
LINEAR_REDIRECT_URI=https://your-domain.example/linear/oauth/callback
BASE_URL=https://your-domain.example
KIMI_WORKDIR=/path/to/your/app
KIMI_COMMAND=kimi
# KIMI_MODEL=
# Difficulty-based model routing: a router model classifies each new agent
# session as easy or hard (one short kimi -p call), then the run uses the
# matching model. Follow-ups reuse the model chosen at creation.
# KIMI_MODEL_ROUTER=kimi-code/kimi-for-coding-highspeed
# KIMI_MODEL_EASY=kimi-code/kimi-for-coding-highspeed
# KIMI_MODEL_HARD=kimi-code/k3-256k
KIMI_SESSION_STORE_PATH=./data/kimi-sessions.json
KIMI_PROGRESS_DEBOUNCE_MS=3000
KIMI_PROGRESS_HEARTBEAT_MS=300000
KIMI_PROGRESS_LONG_TOOL_MS=30000
KIMI_TIMEOUT_MS=1800000
HOST=127.0.0.1
PORT=8787
TOKEN_STORE_PATH=./data/linear-tokens.json
STATE_STORE_PATH=./data/oauth-states.json
